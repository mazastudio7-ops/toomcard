{
  "buildCommand": "node scripts/stamp-sw.js",
  "outputDirectory": ".",
  "cleanUrls": true,
  "functions": {
    "api/render.js": {
      "includeFiles": "cards/**"
    },
    "api/manifest.js": {
      "includeFiles": "cards/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/index-legacy",
      "destination": "/index-legacy.html"
    },
    {
      "source": "/admin/star",
      "destination": "/admin-star.html"
    },
    {
      "source": "/maker",
      "destination": "/maker.html"
    },
    {
      "source": "/dashboard-legacy",
      "destination": "/dashboard-legacy.html"
    },
    {
      "source": "/maker-legacy",
      "destination": "/maker-legacy.html"
    },
    {
      "source": "/templates",
      "destination": "/index.html"
    },
    {
      "source": "/designs",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/card",
      "destination": "/card.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/cards/:path*",
      "destination": "/cards/:path*"
    },
    {
      "source": "/themes/:path*",
      "destination": "/themes/:path*"
    },
    {
      "source": "/bizcard/themes/:path*",
      "destination": "/themes/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/js/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/manifest/:slug.json",
      "destination": "/api/manifest?slug=:slug"
    },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/:slug",
      "destination": "/api/render?slug=:slug"
    },
    {
      "source": "/:company/:slug",
      "destination": "/api/render?slug=:company/:slug"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/cards/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300"
        }
      ]
    }
  ]
}
